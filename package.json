{
  "name": "alkanesjs",
  "version": "1.3.2",
  "description": "An expressive CLI toolset for Alkanes mantained by Bitapes Labs",
  "license": "ISC",
  "type": "commonjs",
  "bin": {
    "boyl": "./dist/index.js"
  },
  "files": [
    "dist",
    "wallets",
    "utils",
    "boxed",
    "traces",
    "abi",
    "abis"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.browser.mjs",
  "browser": "./dist/index.browser.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.mjs",
      "import": "./dist/index.browser.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.browser.mjs"
    },
    "./wallets": {
      "types": "./dist/wallets.d.ts",
      "browser": "./dist/wallets.mjs",
      "import": "./dist/wallets.mjs",
      "require": "./dist/wallets.js",
      "default": "./dist/wallets.mjs"
    },
    "./wallets/package.json": "./wallets/package.json",
    "./package.json": "./package.json",
    "./utils/amm": {
      "types": "./dist/utils-amm.d.ts",
      "browser": "./dist/utils-amm.mjs",
      "import": "./dist/utils-amm.mjs",
      "require": "./dist/utils-amm.js",
      "default": "./dist/utils-amm.mjs"
    },
    "./utils/amm/package.json": "./utils/amm/package.json",
    "./utils/frbtc": {
      "types": "./dist/utils-frbtc.d.ts",
      "browser": "./dist/utils-frbtc.mjs",
      "import": "./dist/utils-frbtc.mjs",
      "require": "./dist/utils-frbtc.js",
      "default": "./dist/utils-frbtc.mjs"
    },
    "./utils/frbtc/package.json": "./utils/frbtc/package.json",
    "./boxed": {
      "types": "./dist/boxed.d.ts",
      "browser": "./dist/boxed.mjs",
      "import": "./dist/boxed.mjs",
      "require": "./dist/boxed.js",
      "default": "./dist/boxed.mjs"
    },
    "./boxed/package.json": "./boxed/package.json",
    "./traces": {
      "types": "./dist/traces.d.ts",
      "browser": "./dist/traces.mjs",
      "import": "./dist/traces.mjs",
      "require": "./dist/traces.js",
      "default": "./dist/traces.mjs"
    },
    "./traces/package.json": "./traces/package.json",
    "./abi": {
      "types": "./dist/abi.d.ts",
      "browser": "./dist/abi.mjs",
      "import": "./dist/abi.mjs",
      "require": "./dist/abi.js",
      "default": "./dist/abi.mjs"
    },
    "./abi/package.json": "./abi/package.json",
    "./abis": {
      "types": "./dist/abis.d.ts",
      "browser": "./dist/abis.mjs",
      "import": "./dist/abis.mjs",
      "require": "./dist/abis.js",
      "default": "./dist/abis.mjs"
    },
    "./abis/package.json": "./abis/package.json"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs && node dist/index.js",
    "dev-nobuild": "node dist/index.js",
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js"
  },
  "author": "",
  "dependencies": {
    "@dotenv-run/esbuild": "^1.5.0",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@magiceden-oss/runestone-lib": "^1.0.2",
    "@noble/secp256k1": "1.6.3",
    "alkanes": "^0.1.0",
    "bignumber.js": "^9.3.0",
    "bip32": "^5.0.0-rc.0",
    "bip322-js": "^3.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "borsher": "^4.0.0",
    "bxrs": "^1.0.0",
    "cbor-x": "^1.6.0",
    "chalk": "^5.4.1",
    "create-hash": "^1.2.0",
    "dotenv": "^16.5.0",
    "ecpair": "2.0.1",
    "env-paths": "^3.0.0",
    "espo-ts": "^1.0.0",
    "inquirer": "^12.6.3",
    "node-stdlib-browser": "^1.3.1",
    "ora": "^8.2.0",
    "sade": "^1.8.1",
    "tiny-async-pool": "^2.1.0",
    "undefined": "^0.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/create-hash": "^1.2.6",
    "@types/create-hmac": "^1.1.3",
    "@types/google-protobuf": "^3.15.12",
    "@types/tiny-async-pool": "^2.0.3",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "magic-string": "^0.30.17",
    "path-browserify": "^1.0.1",
    "rollup": "^4.44.1",
    "rollup-plugin-dts": "^6.2.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3"
  }
}
